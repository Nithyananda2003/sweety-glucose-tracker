# Copy to .env in the repository root. Never commit real credentials.
DATABASE_URL=postgresql://sweety:sweety_local@localhost:5432/sweety
PORT=3001
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
NODE_ENV=development
# Optional; only set to 1 behind a trusted, single-hop reverse proxy.
TRUST_PROXY=0
# Demo credentials are public fixtures; change these for a private deployment.
DEMO_EMAIL=demo@sweety.app
DEMO_PASSWORD=SweetyDemo123!
DEMO_DOCTOR_EMAIL=doctor@sweety.app
DEMO_DOCTOR_PASSWORD=SweetyDoctor123!
# Shared Redis instance for report caching and the BullMQ queue.
REDIS_URL=redis://127.0.0.1:6379
REPORT_CACHE_TTL_SECONDS=300
# 21:00 daily in APP_TIMEZONE (six-field cron: seconds minutes hours day month weekday).
REMINDER_CRON=0 0 21 * * *
# Set only when using the owner CLI to create a doctor; never passed in shell arguments.
DOCTOR_PASSWORD=
# Only needed for integration tests. Tests create/drop their own temporary schema.
TEST_DATABASE_URL=postgresql://sweety:sweety_local@localhost:5432/sweety_test
TEST_REDIS_URL=redis://127.0.0.1:6379/1
# Optional Compose password override. Use URI-safe characters in this value.
POSTGRES_PASSWORD=sweety_local
