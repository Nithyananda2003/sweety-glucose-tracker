{
  "name": "sweety",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "test": "npm run test -w server && npm run test -w client",
    "test:services": "npm run test:services -w server",
    "worker": "npm run worker -w server",
    "reminders:run": "node server/src/reminder-once.js",
    "doctor:create": "node server/src/doctor-admin.js create",
    "doctor:assign": "node server/src/doctor-admin.js assign",
    "doctor:unassign": "node server/src/doctor-admin.js unassign"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.10.0"
  }
}
